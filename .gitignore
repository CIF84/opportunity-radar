.DS_Store
.venv/
__pycache__/
.pytest_cache/
*.egg-info/

# Personal local validation evidence. Aggregate/redacted reports may be tracked;
# raw notes require an explicit repository-privacy and backup decision.
data/live_validation/judgments.jsonl

# Phase 4 replays contain candidate-specific decisions, per-job interpretation,
# and human-judgment-derived evidence. Keep every detailed replay artifact local;
# only the explicitly sanitized aggregate receipt may enter Git.
output/phase4_replay/**/*
!output/phase4_replay/**/
!output/phase4_replay/**/aggregate_summary.json

# Prospective validation previews and future batches contain candidate-derived
# per-opportunity evidence and private human-review material. Only sanitized
# aggregate receipts are repository-safe.
output/phase4_prospective/**/*
!output/phase4_prospective/**/
!output/phase4_prospective/**/aggregate_summary.json

# Semantic compute-allocation audits contain private job identities and frozen
# human-outcome traces. Only sanitized aggregate receipts are repository-safe.
output/semantic_compute_allocation/**/*
!output/semantic_compute_allocation/**/
!output/semantic_compute_allocation/**/aggregate_summary.json

# Semantic compute-worthiness samples expose candidate-derived opportunity
# evidence and private human labels. Only deliberately sanitized aggregate
# receipts may enter Git.
data/semantic_compute_worthiness/*.jsonl
output/semantic_compute_worthiness/**/*
!output/semantic_compute_worthiness/**/
!output/semantic_compute_worthiness/**/aggregate_summary.json
!output/semantic_compute_worthiness/**/aggregate_result.json

# Source-portfolio audits include per-opportunity titles and diagnostic role
# matches. Keep detailed rows local; only the sanitized portfolio/coverage
# aggregate is repository-safe.
output/source_portfolio_audit/**/*
!output/source_portfolio_audit/**/
!output/source_portfolio_audit/**/aggregate_summary.json

# Wave A preflights keep per-vacancy titles, URLs, and source diagnostics local.
# Only deliberately sanitized aggregate receipts may enter Git.
output/wave_a_source_preflight/**/*
!output/wave_a_source_preflight/**/
!output/wave_a_source_preflight/**/aggregate_summary.json

output/production_source_onboarding/**/*
!output/production_source_onboarding/**/
!output/production_source_onboarding/**/aggregate_summary.json
output/spec015-onboarding-state-report.txt

# SPEC-016 Mews onboarding keeps per-vacancy source/detail evidence and state
# reports private. Only the deliberately sanitized aggregate receipt is safe.
output/mews_nested_feed/**/*
!output/mews_nested_feed/**/
!output/mews_nested_feed/**/aggregate_summary.json
output/spec016-mews-state-report.txt

# SPEC-017 keeps per-job market evidence private. Only sanitized aggregate
# transitions, regression verdicts, fingerprints, and conclusions are safe.
output/partial_geography_semantics/**/*
!output/partial_geography_semantics/**/
!output/partial_geography_semantics/**/aggregate_summary.json

# SPEC-018 keeps per-opportunity preference effects and private human-evidence
# joins local. Only the deliberately sanitized aggregate receipt is safe.
output/candidate_direction_promotion/**/*
!output/candidate_direction_promotion/**/
!output/candidate_direction_promotion/**/aggregate_summary.json

# Replaceable local health evidence.
output/test_receipt.json
